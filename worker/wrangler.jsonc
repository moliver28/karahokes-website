// W1 form backend configuration. Deploy runbook lives in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karahokes-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "FORM_ORIGIN": "https://www.karahokes.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karahokes_form",
      "database_id": "6f3a1c2b-9d4e-4f5a-8b7c-1a2b3c4d5e6f"
    }
  ],
  "ratelimits": [
    {
      "name": "form_limiter",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [{ "name": "NOTIFY" }]
}
